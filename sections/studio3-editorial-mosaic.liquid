{% comment %}
  Mosaico editorial (home). Grid com 3 tiles de imagem: o primeiro pode ser marcado
  como "largo" (2x a altura, ocupa a coluna inteira ao lado dos outros 2 empilhados).
  Cada tile é um link com uma imagem full-bleed e um rótulo estilo botão no canto
  inferior direito (ex.: "Ver Produto"). Sem heading — no site de referência
  (Home-layout.html, linhas ~982-1012) o mosaico entra direto após a seção anterior,
  sem título próprio.
{% endcomment %}

{%- style -%}
  .studio3-editorial-mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
  }

  @media screen and (max-width: 768px) {
    .studio3-editorial-mosaic {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
  }

  .studio3-editorial-tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 670 / 382;
    text-decoration: none;
  }

  .studio3-editorial-tile--wide {
    grid-row: 1 / 3;
    aspect-ratio: 576 / 672;
    min-height: 400px;
  }

  @media screen and (max-width: 768px) {
    .studio3-editorial-tile--wide {
      grid-row: auto;
      aspect-ratio: 670 / 382;
      min-height: 280px;
    }
  }

  .studio3-editorial-tile__img,
  .studio3-editorial-tile__img.placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s;
  }

  .studio3-editorial-tile:hover .studio3-editorial-tile__img {
    transform: scale(1.01);
  }

  .studio3-editorial-tile__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1.5rem;
  }

  .studio3-editorial-tile__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    padding: 0.4rem 1.25rem;
    border-radius: 7px;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 600;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    transition: background-color 0.2s, color 0.2s;
  }

  .studio3-editorial-tile:hover .studio3-editorial-tile__btn {
    background-color: var(--studio3-color-gold);
    color: {{ section.settings.button_bg_color }};
  }

  .studio3-editorial-mosaic__empty {
    padding: 2rem;
    text-align: center;
    font-family: var(--font-body-family);
    color: var(--studio3-color-ink-muted);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- liquid
      assign studio3_placeholders = 'hero-apparel-1,hero-apparel-2,hero-apparel-3,lifestyle-1,lifestyle-2,detailed-apparel-1' | split: ','
    -%}
    {%- if section.blocks.size > 0 -%}
      <div class="studio3-editorial-mosaic">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tile_url = block.settings.link
            assign placeholder_index = forloop.index0 | modulo: 6
            assign placeholder_name = studio3_placeholders[placeholder_index]
          -%}
          <a
            {% if tile_url != blank %}
              href="{{ tile_url }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="studio3-editorial-tile{% if block.settings.wide %} studio3-editorial-tile--wide{% endif %}"
            {% if block.settings.alt_text != blank %}
              aria-label="{{ block.settings.alt_text | escape }}"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1500, 1600',
                  sizes: '(min-width: 769px) 50vw, 100vw',
                  class: 'studio3-editorial-tile__img',
                  alt: block.settings.alt_text
              }}
            {%- else -%}
              {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg studio3-editorial-tile__img' }}
            {%- endif -%}
            <div class="studio3-editorial-tile__overlay">
              {%- if block.settings.button_label != blank -%}
                <span class="studio3-editorial-tile__btn">{{ block.settings.button_label }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="studio3-editorial-mosaic__empty">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Studio3 - Mosaico",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Rótulo do tile — cor de fundo",
      "default": "rgba(255, 255, 255, 0.85)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Rótulo do tile — cor do texto",
      "default": "#4C5154"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do rótulo (opcional)",
          "info": "Ex.: \"Ver Produto\". Deixe em branco para não mostrar rótulo."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Texto alternativo (opcional)",
          "info": "Descrição da imagem, usada também como rótulo de acessibilidade do link."
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Tile largo",
          "info": "Marque em apenas 1 tile (geralmente o primeiro) para ocupar 2 linhas do grid."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Studio3 - Mosaico",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}

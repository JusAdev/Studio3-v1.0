{% comment %}
  Faixa escura "Benefícios" — rótulo + título fixo + lista de bullets em 2 colunas,
  lida de `product.metafields.custom.benefits`. Só renderiza se o produto tiver esse
  metafield preenchido. Referência: produto-layout-1.html linhas ~1298-1306 (.bfA).
{% endcomment %}

{%- assign benefits = product.metafields.custom.benefits.value -%}

{%- if benefits != blank -%}
  {%- style -%}
    .studio3-product-benefits {
      background: #3a3230;
      border-radius: 14px;
    }

    .studio3-product-benefits__inner {
      max-width: 96rem;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .studio3-product-benefits__label {
      display: block;
      text-align: center;
      font-family: var(--font-body-family);
      font-size: 1.2rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--studio3-color-gold);
      margin-bottom: 0.75rem;
    }

    .studio3-product-benefits__title {
      max-width: 60rem;
      margin: 0 auto 3rem;
      font-family: var(--font-heading-family);
      font-size: 2rem;
      font-weight: 400;
      line-height: 1.3;
      letter-spacing: 0.01em;
      color: #f5f5f7;
      text-align: center;
    }

    .studio3-product-benefits__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .studio3-product-benefits__list li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1.75rem 2rem;
      font-family: var(--font-body-family);
      font-size: 1.3rem;
      line-height: 1.7;
      color: #e1e1e1;
    }

    @media screen and (max-width: 749px) {
      .studio3-product-benefits__title {
        font-size: 1.5rem;
        margin-bottom: 2rem;
      }

      .studio3-product-benefits__list {
        grid-template-columns: 1fr;
      }

      .studio3-product-benefits__list li {
        padding: 1.25rem 1rem;
      }
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width section-{{ section.id }}-padding">
    <div class="studio3-product-benefits">
      <div class="studio3-product-benefits__inner">
        <span class="studio3-product-benefits__label">{{ 'studio3.product.benefits_label' | t }}</span>
        <h2 class="studio3-product-benefits__title">{{ section.settings.heading }}</h2>
        <ul class="studio3-product-benefits__list">
          {%- for item in benefits -%}
            <li>{{ item }}</li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Studio3 - Benefícios",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Ciência aplicada ao cuidado da pele."
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Studio3 - Benefícios"
    }
  ]
}
{% endschema %}

{% comment %}
  Hero — banner de imagem full-width em container arredondado (~14px), com art
  direction opcional mobile/desktop e overlay de texto opcional (heading/subtitle/
  botão). Referência: Home-layout.html linhas 420-443 (.home2026-hero).
  No estado padrão da referência não há texto sobre o banner — o overlay aqui é
  opcional, pra permitir usar esta mesma section em um banner futuro que precise
  de texto.
{% endcomment %}
{%- style -%}
  .studio3-hero {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
  }

  .studio3-hero__media {
    display: block;
  }

  .studio3-hero__media img,
  .studio3-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .studio3-hero__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 2rem;
    text-align: center;
  }

  .studio3-hero__heading {
    font-family: var(--font-heading-family);
    color: rgb(var(--color-foreground));
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 0;
  }

  .studio3-hero__subtitle {
    font-family: var(--font-body-family);
    color: rgb(var(--color-foreground));
    font-size: clamp(1rem, 2vw, 1.25rem);
    margin: 0;
    max-width: 40em;
  }

  .studio3-hero__button {
    margin-top: 0.5rem;
  }

  #studio3-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #studio3-hero-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign widths_string = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign widths = widths_string | split: ', '
  assign has_content = false
  if section.settings.heading != blank or section.settings.subtitle != blank or section.settings.button_label != blank
    assign has_content = true
  endif
-%}

{%- capture content_html -%}
  {%- if has_content -%}
    <div class="studio3-hero__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="studio3-hero__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="studio3-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <span class="button studio3-hero__button">{{ section.settings.button_label | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div id="studio3-hero-{{ section.id }}" class="page-width">
  {%- if section.settings.image != blank -%}
    {%- capture mobile_srcset -%}
      {%- if section.settings.mobile_image != blank -%}
        {%- for w in widths -%}
          {{ section.settings.mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign mobile_srcset = mobile_srcset | strip_newlines | strip -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="studio3-hero color-{{ section.settings.color_scheme }}">
    {%- else -%}
      <div class="studio3-hero color-{{ section.settings.color_scheme }}">
    {%- endif -%}

      <picture class="studio3-hero__media">
        {%- if mobile_srcset != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_srcset }}" sizes="100vw">
        {%- endif -%}
        {{
          section.settings.image
          | image_url: width: 3840
          | image_tag: widths: widths_string, sizes: '100vw', loading: 'eager', fetchpriority: 'high'
        }}
      </picture>

      {{ content_html }}

    {%- if section.settings.link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="studio3-hero color-{{ section.settings.color_scheme }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'studio3-hero__placeholder-svg' }}
      {{ content_html }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Studio3 Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem (mobile)",
      "info": "Opcional. Se vazia, usa a imagem de desktop também no mobile."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (opcional)"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo (opcional)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão (opcional)",
      "info": "Exibido como botão decorativo — usa o mesmo link do banner."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Studio3 Hero"
    }
  ]
}
{% endschema %}

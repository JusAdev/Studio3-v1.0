{% comment %}
  Faixa "Política de troca" — 3 blocos ícone + título + texto, estáticos (não variam
  por produto). Usado na página de produto, mas é uma section genérica de qualquer
  page-width. Referência: produto-layout-1.html linhas ~1631-1652
  (.product-page__policy-grid).
{% endcomment %}

{%- style -%}
  .studio3-trust-policy {
    background: #f8f5f0;
  }

  .studio3-trust-policy__title {
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 400;
    letter-spacing: 0.112rem;
    color: var(--studio3-color-ink);
    text-align: center;
    margin: 0 0 3.2rem;
  }

  .studio3-trust-policy__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .studio3-trust-policy__grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }

  .studio3-trust-policy__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    text-align: center;
  }

  .studio3-trust-policy__item svg {
    width: 2.8rem;
    height: 2.8rem;
    margin-bottom: 0.4rem;
    color: var(--studio3-color-ink);
  }

  .studio3-trust-policy__item h3 {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--studio3-color-ink);
    margin: 0;
  }

  .studio3-trust-policy__item p {
    font-family: var(--font-body-family);
    font-size: 1.28rem;
    line-height: 1.5;
    color: var(--studio3-color-ink-muted);
    margin: 0;
  }

  .studio3-trust-policy__item a {
    color: var(--studio3-color-ink-muted);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width">
  <div class="studio3-trust-policy color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="studio3-trust-policy__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="studio3-trust-policy__grid">
      {%- for block in section.blocks -%}
        <div class="studio3-trust-policy__item" {{ block.shopify_attributes }}>
          {{ block.settings.icon }}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Studio3 - Política",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Política de troca"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "policy_item",
      "name": "Item",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Ícone (SVG)",
          "default": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\"></rect><path d=\"M16 7V5a4 4 0 0 0-8 0v2\"></path></svg>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Troca em 7 dias"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Troque seus produtos em até 7 dias após o recebimento."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio3 - Política",
      "blocks": [
        {
          "type": "policy_item",
          "settings": {
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2\" y=\"7\" width=\"20\" height=\"14\" rx=\"2\"></rect><path d=\"M16 7V5a4 4 0 0 0-8 0v2\"></path></svg>",
            "title": "Troca em 7 dias",
            "text": "Troque seus produtos em até 7 dias após o recebimento."
          }
        },
        {
          "type": "policy_item",
          "settings": {
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg>",
            "title": "Embalagem original",
            "text": "Produtos em perfeito estado e nunca utilizados."
          }
        },
        {
          "type": "policy_item",
          "settings": {
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>",
            "title": "Compra segura",
            "text": "Saiba mais sobre nossos termos e condições."
          }
        }
      ]
    }
  ]
}
{% endschema %}

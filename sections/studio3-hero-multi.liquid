{% comment %}
  Studio3 Hero Multi — cópia de studio3-hero.liquid (banner full-width em container
  arredondado, art direction mobile/desktop, overlay de texto opcional) com suporte a
  VÁRIOS banners em carrossel. Cada slide é um block, com os mesmos campos da Hero
  original (imagem desktop/mobile, link, título/subtítulo/botão, alinhamento,
  esquema de cor) — ver studio3-hero.liquid pro caso de usar só 1 banner.

  Reaproveita o <slideshow-component> NATIVO do Dawn (assets/global.js, já carregado
  globalmente em layout/theme.liquid) — a mesma classe que a seção nativa "Slideshow"
  (sections/slideshow.liquid) usa, com autoplay, loop infinito (sempre ligado no
  próprio construtor da classe, não é opcional) e setas/contador já prontos — em vez
  de reinventar um carrossel do zero (como foi preciso fazer pro categories-nav, que
  propositalmente NÃO tem botão "anterior" — aqui SIM temos os dois, então a
  SlideshowComponent nativa funciona de primeira, sem o problema do construtor dela
  assumir um botão "previous" que não existe).
{% endcomment %}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .studio3-hero-multi {
    position: relative;
  }

  .studio3-hero-multi__track {
    border-radius: 14px;
    overflow: hidden;
  }

  .studio3-hero-multi__banner {
    position: relative;
    display: block;
  }

  .studio3-hero-multi__media {
    display: block;
  }

  .studio3-hero-multi__media img,
  .studio3-hero-multi__placeholder-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .studio3-hero-multi__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 2rem;
  }

  .studio3-hero-multi__heading {
    font-family: var(--font-heading-family);
    color: rgb(var(--color-foreground));
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1.1;
    margin: 0;
  }

  .studio3-hero-multi__subtitle {
    font-family: var(--font-body-family);
    color: rgb(var(--color-foreground));
    font-size: clamp(1rem, 2vw, 1.25rem);
    margin: 0;
    max-width: 40em;
  }

  .studio3-hero-multi__button {
    margin-top: 0.5rem;
  }

  .studio3-hero-multi__empty {
    border-radius: 14px;
    overflow: hidden;
  }

  .studio3-hero-multi__empty .studio3-hero-multi__placeholder-svg {
    width: 100%;
    height: auto;
  }

  /* Pedido do cliente: setas nas LATERAIS do banner (sobre a imagem, uma de cada
     lado) e os dots/contador ABAIXO do banner (fora da imagem, não sobrepostos) —
     não o padrão nativo do Dawn (que agrupa setas+indicador num só bloco). */
  .studio3-hero-multi__viewport {
    position: relative;
  }

  .studio3-hero-multi__viewport .studio3-hero-multi__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .studio3-hero-multi__viewport .studio3-hero-multi__nav:hover {
    background: rgba(0, 0, 0, 0.55);
  }

  .studio3-hero-multi__nav--prev {
    left: 1.2rem;
  }

  .studio3-hero-multi__nav--next {
    right: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .studio3-hero-multi__nav {
      width: 3.2rem;
      height: 3.2rem;
    }

    .studio3-hero-multi__nav--prev {
      left: 0.6rem;
    }

    .studio3-hero-multi__nav--next {
      right: 0.6rem;
    }
  }

  .studio3-hero-multi__indicator {
    display: flex;
    justify-content: center;
    margin-top: 1.2rem;
  }

  .studio3-hero-multi__indicator .slideshow__control-wrapper {
    gap: 0.6rem;
  }

  /* Botão funcional, não decorativo — ver comentário junto do markup abaixo
     (precisa existir pra SlideshowComponent nativa não quebrar o autoplay),
     mas nosso design não tem um controle de play/pause visível. Escondido
     via regra escoparada (vence ".slider-button" do Dawn independente da
     ordem de carregamento do CSS) em vez de só ".visually-hidden" — o
     ".slider-button" nativo redefine width/height na mesma especificidade. */
  .studio3-hero-multi .slideshow__autoplay {
    display: none;
  }

  #studio3-hero-multi-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #studio3-hero-multi-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="studio3-hero-multi-{{ section.id }}" class="page-width">
  {%- if section.blocks.size > 0 -%}
    {%- liquid
      assign widths_string = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
      assign widths = widths_string | split: ', '
    -%}
    <slideshow-component
      class="studio3-hero-multi"
      role="region"
      aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
      aria-label="Carrossel de banners"
    >
      {%- if section.blocks.size > 1 and section.settings.auto_rotate -%}
        {%- comment -%}
          Botão oculto, não decorativo: o construtor da SlideshowComponent nativa
          (assets/global.js, método setAutoPlay) só chama `this.play()` direto
          quando encontra ".slideshow__autoplay" — sem ele, cai no branch que lê
          `this.reducedMotion.matches`, variável que só existe se a seção também
          tiver um ".announcement-bar-slider" (não é o nosso caso), e quebra com
          "Cannot read properties of undefined" ANTES de chamar play() — é por
          isso que o autoplay nunca rodava, mesmo com "auto_rotate" ativado. Como
          o design aqui não previu um controle de play/pause visível, o botão
          existe só pra satisfazer esse caminho do código nativo.
        {%- endcomment -%}
        <button type="button" class="slideshow__autoplay slider-button" aria-hidden="true" tabindex="-1">
          <span class="svg-wrapper">{{- 'icon-pause.svg' | inline_asset_content -}}</span>
          <span class="svg-wrapper">{{- 'icon-play.svg' | inline_asset_content -}}</span>
        </button>
      {%- endif -%}
      <div class="studio3-hero-multi__viewport">
        {%- if section.blocks.size > 1 -%}
          <button
            type="button"
            class="studio3-hero-multi__nav studio3-hero-multi__nav--prev slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        {%- endif -%}

        <div
          class="studio3-hero-multi__track grid grid--1-col slider slider--everywhere"
          id="Slider-{{ section.id }}"
          aria-live="polite"
          aria-atomic="true"
          data-autoplay="{{ section.settings.auto_rotate }}"
          data-speed="{{ section.settings.change_slides_speed }}"
        >
          {%- for block in section.blocks -%}
          {%- liquid
            assign has_content = false
            if block.settings.heading != blank or block.settings.subtitle != blank or block.settings.button_label != blank
              assign has_content = true
            endif
          -%}
          <div
            class="grid__item grid--1-col slider__slide"
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            {{ block.shopify_attributes }}
            role="group"
            aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
            aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            tabindex="-1"
          >
            {%- capture content_html -%}
              {%- if has_content -%}
                <div
                  class="studio3-hero-multi__content"
                  style="
                    align-items: {% if block.settings.content_alignment == 'left' %}flex-start{% elsif block.settings.content_alignment == 'right' %}flex-end{% else %}center{% endif %};
                    text-align: {{ block.settings.content_alignment }};
                  "
                >
                  {%- if block.settings.heading != blank -%}
                    <h2 class="studio3-hero-multi__heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="studio3-hero-multi__subtitle">{{ block.settings.subtitle | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <span class="button studio3-hero-multi__button">{{ block.settings.button_label | escape }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endcapture -%}

            {%- if block.settings.image != blank -%}
              {%- capture mobile_srcset -%}
                {%- if block.settings.mobile_image != blank -%}
                  {%- for w in widths -%}
                    {{ block.settings.mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
                  {%- endfor -%}
                {%- endif -%}
              {%- endcapture -%}
              {%- assign mobile_srcset = mobile_srcset | strip_newlines | strip -%}

              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="studio3-hero-multi__banner color-{{ block.settings.color_scheme }}">
              {%- else -%}
                <div class="studio3-hero-multi__banner color-{{ block.settings.color_scheme }}">
              {%- endif -%}

                <picture class="studio3-hero-multi__media">
                  {%- if mobile_srcset != blank -%}
                    <source media="(max-width: 749px)" srcset="{{ mobile_srcset }}" sizes="100vw">
                  {%- endif -%}
                  {%- if forloop.first -%}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag: widths: widths_string, sizes: '100vw', loading: 'eager', fetchpriority: 'high'
                    }}
                  {%- else -%}
                    {{
                      block.settings.image
                      | image_url: width: 3840
                      | image_tag: widths: widths_string, sizes: '100vw', loading: 'lazy'
                    }}
                  {%- endif -%}
                </picture>

                {{ content_html }}

              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <div class="studio3-hero-multi__banner color-{{ block.settings.color_scheme }}">
                {{ 'hero-apparel-1' | placeholder_svg_tag: 'studio3-hero-multi__placeholder-svg' }}
                {{ content_html }}
              </div>
            {%- endif -%}
          </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <button
            type="button"
            class="studio3-hero-multi__nav studio3-hero-multi__nav--next slider-button slider-button--next"
            name="next"
            aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
            aria-controls="Slider-{{ section.id }}"
          >
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        {%- comment -%}
          A classe "slider-buttons" aqui é funcional, não visual: o construtor da
          SlideshowComponent nativa (assets/global.js) faz
          `this.querySelector('.slider-buttons')` e retorna cedo (sem configurar
          autoplay nem o clique nos dots) se não encontrar nenhum elemento com essa
          classe em algum lugar do componente — mesmo com o layout tendo mudado
          (setas nas laterais, dots abaixo), o marcador precisa continuar existindo.
        {%- endcomment -%}
        <div class="studio3-hero-multi__indicator slider-buttons slider-counter slider-counter--{{ section.settings.slider_visual }}{% if section.settings.slider_visual == 'counter' %} caption{% endif %}">
          {%- if section.settings.slider_visual == 'counter' -%}
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          {%- else -%}
            <div class="slideshow__control-wrapper">
              {%- for block in section.blocks -%}
                <button
                  class="slider-counter__link slider-counter__link--dots link"
                  aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  <span class="dot"></span>
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </slideshow-component>
  {%- else -%}
    <div class="studio3-hero-multi__empty">
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'studio3-hero-multi__placeholder-svg' }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Studio3 Hero Multi",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Navegação"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Avançar automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 2,
      "unit": "s",
      "label": "Velocidade (segundos entre slides)",
      "default": 5
    },
    {
      "type": "select",
      "id": "slider_visual",
      "label": "Indicador de navegação",
      "options": [
        { "value": "dots", "label": "Bolinhas" },
        { "value": "counter", "label": "Contador (1/3)" }
      ],
      "default": "dots"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Imagem (mobile)",
          "info": "Opcional. Se vazia, usa a imagem de desktop também no mobile."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título (opcional)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo (opcional)"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão (opcional)",
          "info": "Exibido como botão decorativo — usa o mesmo link do banner."
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Alinhamento do texto sobreposto",
          "options": [
            { "value": "left", "label": "Esquerda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Direita" }
          ],
          "default": "center"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Esquema de cor",
          "default": "scheme-1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio3 Hero Multi",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

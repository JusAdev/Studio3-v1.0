{%- liquid
  assign digits = section.settings.phone | strip | replace: ' ', '' | replace: '+', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', ''
  assign message_param = section.settings.message | url_encode | replace: '+', '%20'
-%}

{%- if digits != blank -%}
  <a
    href="https://wa.me/{{ digits }}{% if message_param != blank %}?text={{ message_param }}{% endif %}"
    class="studio3-whatsapp studio3-whatsapp--{{ section.settings.position }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.label | escape }}"
  >
    <svg
      class="studio3-whatsapp__icon"
      viewBox="0 0 24 24"
      width="30"
      height="30"
      aria-hidden="true"
      focusable="false"
    >
      <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
    </svg>
  </a>
{%- endif -%}

{%- style -%}
  .studio3-whatsapp {
    position: fixed;
    bottom: {{ section.settings.offset_mobile }}px;
    z-index: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.6rem;
    height: 5.6rem;
    border-radius: 50%;
    background: {{ section.settings.color }};
    color: #fff;
    box-shadow: 0 0.4rem 1.6rem rgba(0, 0, 0, 0.18);
    text-decoration: none;
  }

  .studio3-whatsapp--right {
    right: 1.6rem;
  }

  .studio3-whatsapp--left {
    left: 1.6rem;
  }

  .studio3-whatsapp:hover {
    opacity: 0.92;
  }

  .studio3-whatsapp:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .studio3-whatsapp {
      bottom: {{ section.settings.offset_desktop }}px;
      width: 6rem;
      height: 6rem;
    }

    .studio3-whatsapp--right {
      right: 2.4rem;
    }

    .studio3-whatsapp--left {
      left: 2.4rem;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Studio3 - WhatsApp",
  "tag": "div",
  "class": "studio3-whatsapp-section",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Número do WhatsApp",
      "info": "Com DDI e DDD, só números. Ex.: 5562999999999. Deixe em branco para não exibir o botão."
    },
    {
      "type": "text",
      "id": "message",
      "label": "Mensagem inicial",
      "default": "Olá! Gostaria de mais informações."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto para leitores de tela",
      "default": "Fale conosco pelo WhatsApp"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Posição",
      "options": [
        { "value": "right", "label": "Direita" },
        { "value": "left", "label": "Esquerda" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "color",
      "label": "Cor do botão",
      "default": "#25d366"
    },
    {
      "type": "range",
      "id": "offset_desktop",
      "label": "Distância da borda inferior (desktop)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "offset_mobile",
      "label": "Distância da borda inferior (celular)",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}

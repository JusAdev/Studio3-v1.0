{% comment %}
  Faixa promocional — imagem full-width, borda reta (edge-to-edge, sem container),
  envolta em link. Mais simples que o hero: sem overlay de texto, sem cantos
  arredondados. Referência: Home-layout.html linhas 723-738 (.home2026-promo-banner),
  que não fica dentro do wrapper .my-container-fluid usado pelo hero — por isso é
  renderizada fora do .page-width aqui também.
{% endcomment %}
{%- style -%}
  .studio3-promo-banner {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .studio3-promo-banner img {
    display: block;
    width: 100%;
    height: auto;
  }

  #studio3-promo-banner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #studio3-promo-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' | split: ', '
  assign alt_text = section.settings.alt_text
-%}

<div id="studio3-promo-banner-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {%- capture mobile_srcset -%}
      {%- if section.settings.mobile_image != blank -%}
        {%- for w in widths -%}
          {{ section.settings.mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign mobile_srcset = mobile_srcset | strip_newlines | strip -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="studio3-promo-banner">
    {%- else -%}
      <div class="studio3-promo-banner">
    {%- endif -%}

      <picture>
        {%- if mobile_srcset != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_srcset }}" sizes="100vw">
        {%- endif -%}
        {%- if alt_text != blank -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag: widths: widths, sizes: '100vw', loading: 'lazy', alt: alt_text
          }}
        {%- else -%}
          {{
            section.settings.image
            | image_url: width: 3840
            | image_tag: widths: widths, sizes: '100vw', loading: 'lazy'
          }}
        {%- endif -%}
      </picture>

    {%- if section.settings.link != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Studio3 Faixa promo",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem (desktop)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem (mobile)",
      "info": "Opcional. Se vazia, usa a imagem de desktop também no mobile."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (opcional)",
      "info": "Descrição da imagem para leitores de tela. Se vazio, usa o texto alternativo do arquivo enviado."
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Studio3 Faixa promo"
    }
  ]
}
{% endschema %}

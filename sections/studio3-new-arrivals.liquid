{% comment %}
  Seção "Últimos Lançamentos" — vitrine da home com cabeçalho, um banner de
  imagem (sem produto em destaque) e uma grade regular de até 8 produtos,
  seguida de um link "ver todos". Referência: Home-layout.html, linhas
  740-980.

  Todo o markup/CSS do padrão cabeçalho + banner + grid + CTA vem de
  snippets/studio3-product-grid-section.liquid (não duplicar aqui — só passar
  os settings certos pro snippet compartilhado, que também chama
  snippets/card-product.liquid pra cada bloco de produto).
{% endcomment %}
<div class="color-{{ section.settings.color_scheme }} gradient">
  {%- render 'studio3-product-grid-section',
    section: section,
    heading: section.settings.heading,
    subtitle: section.settings.subtitle,
    banner_image: section.settings.banner_image,
    banner_url: section.settings.banner_url,
    cta_text: section.settings.cta_text,
    cta_url: section.settings.cta_url
  -%}
</div>

{% schema %}
{
  "name": "Studio3 - Lançamentos",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Últimos Lançamentos"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Imagem do banner"
    },
    {
      "type": "url",
      "id": "banner_url",
      "label": "Link do banner"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Texto do link para ver todos",
      "default": "Ver todos os Lançamentos"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link do ver todos"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cor",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Produto",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio3 - Lançamentos",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Navegação de categorias por ícone — modelo 3 do protótipo
  prototipo-categories-nav.html ("chips/pills compactos"): pastilha horizontal com
  ícone pequeno + rótulo lado a lado, em vez do círculo grande + rótulo embaixo do
  modelo anterior. `flex-wrap` deixa todas as categorias visíveis sem exigir scroll
  horizontal (ao contrário do modelo 1, que este substitui).

  Cada categoria pode usar uma imagem própria (image_picker, upload do lojista) OU um
  ícone pronto de uma biblioteca de 7 ícones de linha (mesmo conjunto do protótipo,
  ver snippets/studio3-category-icon.liquid) — settings `icon_source`/`icon_preset`
  no block, com `visible_if` mostrando só o campo relevante no editor.
{% endcomment %}
{%- style -%}
  .studio3-categories-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .studio3-cat-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.6rem 0.9rem 1.2rem;
    border: 1px solid var(--studio3-border-subtle);
    border-radius: 999px;
    background: rgb(var(--color-background));
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .studio3-cat-icon:hover {
    border-color: var(--studio3-color-cobalt);
    background-color: var(--studio3-color-cobalt-light);
  }

  .studio3-cat-icon__img,
  .studio3-cat-icon__svg {
    display: block;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    object-fit: contain;
  }

  /* Ícone da biblioteca (SVG inline) é recolorável via currentColor — ao contrário
     do ícone personalizado (<img>, raster), que mantém as cores originais do
     arquivo enviado pelo lojista. */
  .studio3-cat-icon__svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--studio3-color-ink-muted);
  }

  .studio3-cat-icon__label {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--studio3-color-ink);
    letter-spacing: normal;
    white-space: nowrap;
  }

  #studio3-categories-nav-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #studio3-categories-nav-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="studio3-categories-nav-{{ section.id }}" class="page-width">
  <nav class="studio3-categories-nav" aria-label="Categorias de produtos">
    {%- for block in section.blocks -%}
      <a
        {%- if block.settings.link != blank %}
          href="{{ block.settings.link }}"
        {%- else %}
          role="link" aria-disabled="true"
        {%- endif %}
        class="studio3-cat-icon"
        {%- if block.settings.label != blank %}
          aria-label="Acesse {{ block.settings.label | escape }}"
        {%- endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon_source == 'library' -%}
          {%- render 'studio3-category-icon', icon: block.settings.icon_preset -%}
        {%- elsif block.settings.icon != blank -%}
          {{
            block.settings.icon
            | image_url: width: 64
            | image_tag: width: 32, height: 32, loading: 'lazy', class: 'studio3-cat-icon__img'
          }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'studio3-cat-icon__img' }}
        {%- endif -%}
        {%- if block.settings.label != blank -%}
          <span class="studio3-cat-icon__label">{{ block.settings.label | escape }}</span>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </nav>
</div>

{% schema %}
{
  "name": "Studio3 Categorias",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "select",
          "id": "icon_source",
          "label": "Fonte do ícone",
          "options": [
            { "value": "custom", "label": "Imagem personalizada" },
            { "value": "library", "label": "Ícone da biblioteca" }
          ],
          "default": "custom"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Ícone personalizado",
          "visible_if": "{{ block.settings.icon_source == 'custom' }}"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Ícone da biblioteca",
          "options": [
            { "value": "serum", "label": "Sérum" },
            { "value": "sun", "label": "Proteção solar" },
            { "value": "ampoule", "label": "Ampola" },
            { "value": "home", "label": "Home care" },
            { "value": "bolt", "label": "Alta tecnologia" },
            { "value": "leaf", "label": "Sensorial" },
            { "value": "mask", "label": "Máscara" }
          ],
          "default": "serum",
          "visible_if": "{{ block.settings.icon_source == 'library' }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio3 Categorias",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

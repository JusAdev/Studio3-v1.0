{% comment %}
  Navegação de categorias por ícone — modelo 3 do protótipo
  prototipo-categories-nav.html ("chips/pills compactos"): pastilha horizontal com
  ícone pequeno + rótulo lado a lado, em vez do círculo grande + rótulo embaixo do
  modelo anterior.

  Nunca quebra pra 2ª linha, em NENHUMA largura — a rolagem em si (scroll-snap,
  arraste/toque) reaproveita o CSS do `<slider-component>` nativo do Dawn
  (`.slider`/`.slider--everywhere`, component-slider.css, mesmo import de sempre:
  ver sections/featured-collection.liquid, collection-list.liquid etc.), mas quem
  controla a navegação é um custom element PRÓPRIO
  (assets/studio3-categories-nav.js, `<studio3-categories-slider>`) — pedido do
  cliente foi autoplay + loop infinito + um ÚNICO botão "avançar" flutuante (não o
  par prev/next com contador do Dawn), o que a `SliderComponent` nativa não faz e
  não dá pra configurar via atributo. Quando os itens cabem todos na largura
  disponível (sem overflow), a fileira fica centralizada (`justify-content: safe
  center` — o `safe` evita que o navegador esconda o primeiro item ao rolar quando
  a lista É maior que o espaço disponível; sem o `safe`, centralizar uma lista que
  estoura a largura pode cortar o início dela do lado de fora do scroll).

  Cada categoria pode usar uma imagem própria (image_picker, upload do lojista) OU um
  ícone pronto de uma biblioteca de 7 ícones de linha (mesmo conjunto do protótipo,
  ver snippets/studio3-category-icon.liquid) — settings `icon_source`/`icon_preset`
  no block, com `visible_if` mostrando só o campo relevante no editor.
{% endcomment %}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'studio3-categories-nav.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #studio3-categories-nav-{{ section.id }} {
    --studio3-cat-icon-bg: {{ section.settings.chip_bg_color }};
    --studio3-cat-icon-border: {{ section.settings.chip_border_color }};
    --studio3-cat-icon-text: {{ section.settings.chip_text_color }};
    --studio3-cat-icon-icon: {{ section.settings.chip_icon_color }};
    --studio3-cat-icon-bg-hover: {{ section.settings.chip_bg_color_hover }};
    --studio3-cat-icon-border-hover: {{ section.settings.chip_border_color_hover }};
  }

  .studio3-categories-nav-slider {
    position: relative;
    display: block;
  }

  .studio3-categories-nav {
    display: flex;
    flex-wrap: nowrap;
    gap: 1rem;
    justify-content: center;
    justify-content: safe center;
  }

  /* Botão único de avançar, flutuante sobre a borda direita da fileira (não um
     par prev/next alinhado embaixo) — fica por cima de parte do último item
     visível de propósito (pedido do cliente), não colado do lado de fora. */
  .studio3-categories-nav__next {
    position: absolute;
    top: 50%;
    right: 0.4rem;
    transform: translateY(-50%);
    z-index: 2;
    width: 4rem;
    height: 4rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(var(--color-background));
    box-shadow: var(--studio3-shadow-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--studio3-color-ink);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .studio3-categories-nav__next:hover {
    background-color: var(--studio3-color-cobalt-light);
  }

  .studio3-categories-nav__next .icon {
    width: 1.6rem;
    height: 1.6rem;
    /* Mesma técnica do slider-button--next nativo do Dawn: icon-caret.svg
       aponta pra baixo por padrão, rotacionado pra apontar pra direita aqui. */
    transform: rotate(-90deg);
  }

  .studio3-cat-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.6rem 0.9rem 1.2rem;
    border: 1px solid var(--studio3-cat-icon-border);
    border-radius: 999px;
    background: var(--studio3-cat-icon-bg);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .studio3-cat-icon:hover {
    border-color: var(--studio3-cat-icon-border-hover);
    background-color: var(--studio3-cat-icon-bg-hover);
  }

  .studio3-cat-icon__img,
  .studio3-cat-icon__svg {
    display: block;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    object-fit: contain;
  }

  /* Ícone da biblioteca (SVG inline) é recolorável via currentColor — ao contrário
     do ícone personalizado (<img>, raster), que mantém as cores originais do
     arquivo enviado pelo lojista. */
  .studio3-cat-icon__svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    color: var(--studio3-cat-icon-icon);
  }

  .studio3-cat-icon__label {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--studio3-cat-icon-text);
    letter-spacing: normal;
    white-space: nowrap;
  }

  #studio3-categories-nav-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #studio3-categories-nav-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="studio3-categories-nav-{{ section.id }}" class="page-width">
  <nav aria-label="Categorias de produtos">
    <studio3-categories-slider
      class="studio3-categories-nav-slider"
      data-autoplay="{{ section.settings.autoplay }}"
      data-speed="{{ section.settings.autoplay_speed }}"
    >
      <ul
        id="Slider-{{ section.id }}"
        class="studio3-categories-nav slider slider--everywhere list-unstyled"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="slider__slide">
            <a
              {%- if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {%- else %}
                role="link" aria-disabled="true"
              {%- endif %}
              class="studio3-cat-icon"
              {%- if block.settings.label != blank %}
                aria-label="Acesse {{ block.settings.label | escape }}"
              {%- endif %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon_source == 'library' -%}
                {%- render 'studio3-category-icon', icon: block.settings.icon_preset -%}
              {%- elsif block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 64
                  | image_tag: width: 32, height: 32, loading: 'lazy', class: 'studio3-cat-icon__img'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'studio3-cat-icon__img' }}
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="studio3-cat-icon__label">{{ block.settings.label | escape }}</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if section.blocks.size > 1 -%}
        <button
          type="button"
          class="studio3-categories-nav__next"
          data-studio3-categories-next
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
        </button>
      {%- endif -%}
    </studio3-categories-slider>
  </nav>
</div>

{% schema %}
{
  "name": "Studio3 Categorias",
  "tag": "section",
  "class": "section",
  "max_blocks": 16,
  "settings": [
    {
      "type": "header",
      "content": "Navegação automática"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Avançar automaticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Velocidade (segundos entre cada avanço)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "color",
      "id": "chip_bg_color",
      "label": "Fundo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "chip_border_color",
      "label": "Borda",
      "default": "rgba(223, 223, 228, 0.6)"
    },
    {
      "type": "color",
      "id": "chip_text_color",
      "label": "Texto",
      "default": "#4C5154"
    },
    {
      "type": "color",
      "id": "chip_icon_color",
      "label": "Ícone (só afeta ícones da biblioteca, não imagens personalizadas)",
      "default": "#6B7479"
    },
    {
      "type": "color",
      "id": "chip_bg_color_hover",
      "label": "Fundo (hover)",
      "default": "#D6DEE3"
    },
    {
      "type": "color",
      "id": "chip_border_color_hover",
      "label": "Borda (hover)",
      "default": "#4F6478"
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "select",
          "id": "icon_source",
          "label": "Fonte do ícone",
          "options": [
            { "value": "custom", "label": "Imagem personalizada" },
            { "value": "library", "label": "Ícone da biblioteca" }
          ],
          "default": "custom"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Ícone personalizado",
          "visible_if": "{{ block.settings.icon_source == 'custom' }}"
        },
        {
          "type": "select",
          "id": "icon_preset",
          "label": "Ícone da biblioteca",
          "options": [
            { "value": "serum", "label": "Sérum" },
            { "value": "sun", "label": "Proteção solar" },
            { "value": "ampoule", "label": "Ampola" },
            { "value": "home", "label": "Home care" },
            { "value": "bolt", "label": "Alta tecnologia" },
            { "value": "leaf", "label": "Sensorial" },
            { "value": "mask", "label": "Máscara" }
          ],
          "default": "serum",
          "visible_if": "{{ block.settings.icon_source == 'library' }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio3 Categorias",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}

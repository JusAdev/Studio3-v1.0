{% comment %}
  "Modo de usar" + "Composição (INCI)" — 2 faixas cinza full-width, lidas de
  metafields do produto (`custom.how_to_use`, `custom.composition_inci`). Só
  renderiza cada bloco se o metafield tiver conteúdo — produto sem esse dado
  preenchido simplesmente não mostra a faixa correspondente. Referência:
  produto-layout-1.html linhas ~1605-1626 (.product-page__section--gray).
{% endcomment %}

{%- style -%}
  .studio3-product-details {
    background: #fafafa;
  }

  .studio3-product-details__inner {
    max-width: 96rem;
    margin: 0 auto;
    padding: 0 1.6rem;
  }

  .studio3-product-details__title {
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 400;
    letter-spacing: 0.112rem;
    color: var(--studio3-color-ink);
    text-align: center;
    margin: 0 0 3.2rem;
  }

  .studio3-product-details__text {
    font-family: var(--font-body-family);
    font-size: 1.472rem;
    line-height: 1.9;
    color: var(--studio3-color-ink-muted);
    padding: 0 0.4rem;
  }

  .studio3-product-details__allergy {
    display: flex;
    align-items: flex-start;
    gap: 0.96rem;
    background: #00000008;
    border-radius: 10px;
    margin-top: 2.4rem;
    padding: 1.6rem 2rem;
  }

  .studio3-product-details__allergy svg {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: 0.16rem;
    color: var(--studio3-color-ink-muted);
  }

  .studio3-product-details__allergy p {
    font-family: var(--font-body-family);
    font-size: 1.28rem;
    line-height: 1.5;
    color: var(--studio3-color-ink-muted);
    margin: 0;
  }

  .studio3-product-details__composition-label {
    display: block;
    font-family: var(--font-body-family);
    font-size: 1.28rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--studio3-color-ink);
    text-align: left;
    margin-bottom: 0.8rem;
  }

  .studio3-product-details__composition-text {
    font-family: var(--font-body-family);
    font-size: 1.152rem;
    line-height: 1.7;
    color: var(--studio3-color-ink-muted);
    text-transform: lowercase;
  }

  .studio3-product-details__composition-text:first-letter {
    text-transform: uppercase;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign how_to_use = product.metafields.custom.how_to_use.value -%}
{%- assign composition = product.metafields.custom.composition_inci.value -%}

{%- if how_to_use != blank -%}
  <div class="page-width">
    <div class="studio3-product-details section-{{ section.id }}-padding">
      <div class="studio3-product-details__inner">
        <h2 class="studio3-product-details__title">{{ 'studio3.product.how_to_use' | t }}</h2>
        <p class="studio3-product-details__text">{{ how_to_use }}</p>
        <div class="studio3-product-details__allergy">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16">
            <circle cx="8" cy="8" r="7" stroke="currentColor"></circle>
            <path stroke="currentColor" d="M8 4.5v4"></path>
            <circle cx="8" cy="11.5" r=".75" fill="currentColor"></circle>
          </svg>
          <p>{{ 'studio3.product.allergy_notice' | t }}</p>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if composition != blank -%}
  <div class="page-width">
    <div class="studio3-product-details section-{{ section.id }}-padding" style="padding-top: 0;">
      <div class="studio3-product-details__inner">
        <span class="studio3-product-details__composition-label">{{ 'studio3.product.composition' | t }}</span>
        <p class="studio3-product-details__composition-text">{{ composition }}</p>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Studio3 - Detalhes",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Studio3 - Detalhes"
    }
  ]
}
{% endschema %}

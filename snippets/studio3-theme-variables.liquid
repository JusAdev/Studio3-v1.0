{% comment %}
  Tokens de design centralizados do projeto Studio3 (playbook seção 4.4).
  Fontes e cores extraídas do CSS real do site de referência (Protótipo Referências/).
  Renderizado uma única vez em layout/theme.liquid, depois de base.css, pra sobrescrever
  --font-body-family/--font-heading-family nativos do Dawn com as fontes self-hosted do
  projeto. Nenhuma seção deve usar hex de cor ou nome de fonte direto — sempre via estas
  custom properties.
{% endcomment %}
<style>
  /* Troca de fonte (pedido do cliente: "substitua as fontes por outras", depois de
     rejeitar a primeira leva do redesign visual por achar mirabolante/Arsenal
     inadequada). Manrope (títulos) + Inter (texto) — pares neutros, bem estabelecidos,
     sem personalidade "decorativa" como a serifada Arsenal. Cada arquivo é uma fonte
     variável (a Google serve o MESMO arquivo pros pesos 400/700/800 — ou 400/600/700 —
     só varia o `font-weight` declarado; o navegador escolhe a instância certa dentro
     do próprio arquivo). Só o peso "latin" foi baixado (cobre os acentos do
     português — U+0000-00FF já inclui á/ã/ç/é/etc.). */
  @font-face {
    font-family: 'Studio3 Manrope';
    src: url({{ 'studio3-manrope-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Studio3 Manrope';
    src: url({{ 'studio3-manrope-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Studio3 Manrope';
    src: url({{ 'studio3-manrope-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 800;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Studio3 Inter';
    src: url({{ 'studio3-inter-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Studio3 Inter';
    src: url({{ 'studio3-inter-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Studio3 Inter';
    src: url({{ 'studio3-inter-variable.woff2' | asset_url }}) format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Tipografia — sobrescreve as variáveis nativas do Dawn (font_picker) para usar as
       fontes reais do site de referência em vez da fonte padrão do tema. */
    --font-heading-family: 'Studio3 Manrope', sans-serif;
    --font-heading-style: normal;
    --font-heading-weight: 700;
    --font-body-family: 'Studio3 Inter', sans-serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 600;

    /* Cor de tinta principal (texto/ícones) — usada em quase todo o site de referência */
    --studio3-color-ink: #4c5154;
    --studio3-color-ink-muted: #6b7479;

    /* Verde de ação (CTA sólido, "compra rápida", finalizar compra) */
    --studio3-color-accent: #2d8019;
    --studio3-color-accent-strong: #1d9001;

    /* Cinza-azulado ("Cobalto Acinzentado", nova paleta) usado em selos "exclusivo" e
       detalhes de destaque — antes era dourado/bege (--studio3-color-gold: #ae9570),
       substituído a pedido do cliente (paleta sem bege/amarelo, só preto/branco/cinza-
       azulado + o verde de ação acima, que continua intocado). */
    --studio3-color-cobalt: #4f6478;
    --studio3-color-cobalt-light: #d6dee3;

    /* Barra de frete grátis — teste com o trio de azuis da paleta 07 (claro/médio/
       escuro), em vez do par cobalto acima. Claro no fundo (trilho), degradê de 3
       tons no preenchimento. */
    --studio3-shipping-bar-bg: #7bacdc;
    --studio3-shipping-bar-text: #3a3a3a;
    --studio3-shipping-bar-gradient: linear-gradient(90deg, #7bacdc, #3783cc, #1b3e69);

    /* Gradiente animado do item de menu promocional ("Oferta do mês") — extraído via
       getComputedStyle do span.gradient-animated-text real em tulipia.com.br. Paleta própria
       (vermelho/rosa/ciano), não é o mesmo verde/turquesa da barra de frete acima. */
    --studio3-promo-gradient: linear-gradient(270deg, #ec574a 4%, #f12bd4 50%, #26cbf5 100%);

    /* Bordas/sombras sutis recorrentes no site de referência */
    --studio3-border-subtle: rgba(223, 223, 228, 0.25);
    --studio3-shadow-soft: 1px 1px 4px rgba(0, 0, 0, 0.1);
  }
</style>

{% comment %}
  Preço do card, ou mensagem "exclusivo para profissionais" no lugar do preço quando
  aplicável (produto com a tag `exclusivo-profissional` e visitante sem sessão logada).
  Não usa o snippet nativo `price` — a referência tem um tratamento tipográfico
  específico (número grande + centavos pequenos, "De: / por:" no desconto) que o
  `price` genérico do Dawn não reproduz.

  Accepts:
  - product: {Object} Product Liquid object
  - exclusive: {Boolean} Se true, mostra a mensagem de exclusividade em vez do preço
    (calculado uma única vez em card-product.liquid e passado pra cá pra não duplicar a
    lógica em dois arquivos).

  Usage:
  {% render 'studio3-card-price', product: product, exclusive: studio3_exclusive %}
{% endcomment %}
{%- if exclusive -%}
  <p class="studio3-card__exclusive-msg">{{ 'studio3.card.exclusive_message' | t }}</p>
{%- else -%}
  {%- liquid
    assign target = product.selected_or_first_available_variant
    assign compare_at = target.compare_at_price
    assign price = target.price
    assign discount_percent = 0
    if compare_at > price
      assign discount_percent = compare_at | minus: price | times: 100.0 | divided_by: compare_at | round
    endif
  -%}
  <div class="studio3-card__pricing">
    {%- if compare_at > price -%}
      <div class="studio3-card__price-row">
        <span class="studio3-card__price-was">
          {{ 'studio3.card.price_from' | t }} <s>{{ compare_at | money }}</s>
        </span>
        <span class="studio3-card__price-current-row">
          <span class="studio3-card__price-current">
            <span class="studio3-card__price-prefix">{{ 'studio3.card.price_to' | t }}</span>
            {%- render 'studio3-price-split', amount: price -%}
          </span>
          {%- if discount_percent > 0 -%}
            <span class="studio3-card__badge studio3-card__badge--sale">-{{ discount_percent }}%</span>
          {%- endif -%}
        </span>
      </div>
    {%- else -%}
      <span class="studio3-card__price-current">
        {%- render 'studio3-price-split', amount: price -%}
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

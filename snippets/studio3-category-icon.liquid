{% comment %}
  Ícone de categoria pré-formatado ("biblioteca de ícones") — alternativa ao upload de
  imagem própria (image_picker) na seção Studio3 Categorias. Mesmo conjunto de ícones
  de linha do protótipo prototipo-categories-nav.html (7 ícones, um por categoria real
  do catálogo). SVG inline, recolorável via currentColor (ao contrário do <img> do
  ícone personalizado, que é raster e não pode ser recolorido).

  Accepts:
  - icon: {String} chave do ícone (serum, sun, ampoule, home, bolt, leaf, mask)

  Usage:
  {% render 'studio3-category-icon', icon: block.settings.icon_preset %}
{% endcomment %}
{%- case icon -%}
  {%- when 'serum' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M10 3h4" />
      <path d="M10 3v4.5L7.5 10A3 3 0 0 0 6.5 12.3V19a2 2 0 0 0 2 2h7a2 2 0 0 0 2-2v-6.7A3 3 0 0 0 16.5 10L14 7.5V3" />
      <path d="M8 15h8" />
    </svg>
  {%- when 'sun' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v3M12 18.5v3M21.5 12h-3M5.5 12h-3M18.5 5.5l-2.1 2.1M7.6 16.4l-2.1 2.1M18.5 18.5l-2.1-2.1M7.6 7.6 5.5 5.5" />
    </svg>
  {%- when 'ampoule' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M10 2.5v4.2" />
      <path d="M14 2.5v4.2" />
      <path d="M9.5 2.5h5" />
      <path d="M8.5 8.2h7" />
      <path d="M8.7 8.2 8 17a4 4 0 0 0 4 4.5 4 4 0 0 0 4-4.5l-.7-8.8" />
    </svg>
  {%- when 'home' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 11.5 12 4l8 7.5" />
      <path d="M6 10v9.5a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V10" />
      <path d="M10 20.5v-6h4v6" />
    </svg>
  {%- when 'bolt' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.5 2.5 5 13.5h5.5L11 21.5l7.5-11.5H13z" />
    </svg>
  {%- when 'leaf' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 14.5C6 8 11 4 19 4c0 8-4 13-10.5 13" />
      <path d="M6 14.5c0 2.5 1 4 2.5 5.5" />
      <path d="M8.5 20 15 13.5" />
    </svg>
  {%- when 'mask' -%}
    <svg class="studio3-cat-icon__svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3c-4 0-7 3-7 8v3c0 4 3 7 7 7s7-3 7-7v-3c0-5-3-8-7-8Z" />
      <path d="M9 11.5c.6-.6 1.4-.6 2 0M13 11.5c.6-.6 1.4-.6 2 0" />
      <path d="M9.5 16c1.6 1 3.4 1 5 0" />
    </svg>
{%- endcase -%}
